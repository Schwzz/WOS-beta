Screen { background: $background; color: $foreground; }
#heading { height: 3; padding: 0 3; align-vertical: middle; border-bottom: solid $panel; }
#brand { width: 12; color: $primary; text-style: bold; }
#heading-subtitle { width: 1fr; color: $text-muted; text-align: right; text-overflow: ellipsis; }
#body { height: 1fr; }
#main { width: 1fr; padding: 0 3; }
#transcript { height: 1fr; scrollbar-size: 1 1; padding: 0 1; }
#welcome { height: 1fr; content-align: center middle; text-align: center; color: $text-muted; }
.speaker { height: auto; margin-top: 0; text-style: bold; color: $primary; }
.speaker.user { color: $secondary; }
.message { height: auto; padding: 0 0 1 0; margin: 0; background: transparent; }
.message.user { color: $foreground; }
MarkdownH1, MarkdownH2, MarkdownH3 { margin: 0; }
#notice-row { height: 1; margin-top: 1; }
#notice { width: 1fr; height: 1; color: $secondary; text-overflow: ellipsis; }
#details-toggle { width: 12; min-width: 12; height: 1; border: none; padding: 0; background: $surface; color: $primary; }
#pending { height: auto; max-height: 3; color: $text-muted; margin: 1 0; }
#slash-menu { height: auto; max-height: 8; background: $panel; border: round $primary; }
#input-box { height: auto; margin-top: 1; border: round $panel; padding: 0 1; }
#input-box:focus-within { border: round $primary; }
#composer { height: 3; max-height: 6; border: none; padding: 0; background: $background; }
#composer:focus { border: none; }
#sidebar { width: 28; padding: 1 2; background: $surface; border-left: solid $panel; }
.section-label { color: $text-muted; text-style: bold; height: 1; margin: 1 0; }
#chat-details { height: auto; margin-bottom: 1; }
#chat-list { height: 1fr; background: transparent; padding: 0; border: none; }
#shortcut-list { height: 7; color: $text-muted; margin-top: 1; }
#status { height: 1; padding: 0 4; color: $text-muted; text-overflow: ellipsis; }
Footer { background: $background; color: $text-muted; padding: 0 3; }
ChoiceScreen, PromptScreen, DetailsScreen { align: center middle; background: $background 80%; }
#dialog { width: 74; max-width: 95%; height: auto; max-height: 85%; background: $surface; border: round $primary; padding: 1 2; }
#details-dialog { width: 100; max-width: 95%; height: 85%; background: $surface; border: round $primary; padding: 1 2; }
#details-log { height: 1fr; background: $surface; scrollbar-size: 1 1; }
#details-close { height: 3; margin-top: 1; }
.dialog-title { height: auto; max-height: 5; margin-bottom: 1; text-style: bold; }
#picker-search, #prompt-answer { margin-bottom: 1; }
#picker-options { height: auto; min-height: 2; max-height: 14; background: $surface; border: none; }
.dialog-hint { color: $text-muted; margin-top: 1; height: 1; text-overflow: ellipsis; }
.dialog-buttons { height: 3; align-horizontal: right; }
.dialog-buttons Button { margin-left: 1; }
.short #heading { height: 2; }
.short #main { padding: 0 1; }
.short #composer { height: 2; }
.short #input-box { margin-top: 0; }
.short #slash-menu { max-height: 5; }
.short #notice-row { margin: 0; }
.short #status { padding: 0 2; }
